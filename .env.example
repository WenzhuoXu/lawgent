# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Provider selection ---
# claude_code (the config.yaml default) runs each turn inside Claude Code on a
# claude.ai subscription: run `claude auth login` once, no API key needed.
# anthropic / openai run the in-repo author loop on the keys below.
MODEL_PROVIDER=claude_code          # claude_code | anthropic | openai

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_FAST_MODEL=claude-sonnet-5

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol            # always a named variant; there is no bare "gpt-6.1" alias
OPENAI_FAST_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=medium      # none | low | medium | high | xhigh
OPENAI_ENABLE_FILE_SEARCH=false
OPENAI_FILE_SEARCH_VECTOR_STORE_IDS=

# --- PRC legal data ---
# PKULaw: research source cn.pkulaw and the remote HTTP MCP services in
# .mcp.json (pkulaw_*). Token from mcp.pkulaw.com → 控制台 → 应用管理 → 创建应用;
# sent as `Authorization: Bearer`. Without it, cn.flk (国家法律法规数据库) still
# serves official statute text, versions and status, but no 部门规章 and no cases.
PKULAW_API_TOKEN=

# --- Other official sources (optional; research-layer adapters, nothing to install) ---
# A source whose key is missing reports `needs key`; every other source is keyless.
GOVINFO_API_KEY=                    # api.data.gov key for us.govinfo
COURTLISTENER_API_TOKEN=            # raises us.courtlistener rate limits
PISTE_CLIENT_ID=                    # fr.legifrance and fr.judilibre (a free PISTE app)
PISTE_CLIENT_SECRET=

# --- Behavior ---
LEGAL_HELPER_MAX_ITERATIONS=12
LEGAL_HELPER_OUTPUTS_DIR=outputs
LEGAL_HELPER_STATE_DIR=state
LEGAL_HELPER_LOGS_DIR=logs

# --- Context ---
# Conda env that stdio MCP commands (python, npx) are resolved against.
LEGAL_HELPER_MCP_ENV=llm
# Tokens of extracted attachment text a turn may inline before the rest are
# replaced by a navigable outline (headings, clause labels, the read_document
# call that opens them). Unset = 40% of the turn's input ceiling; 0 = inline all.
LEGAL_HELPER_INLINE_ATTACHMENT_TOKENS=
# Anthropic server-side tool-result clearing is on by default, triggered at the
# turn input ceiling. 0/off disables it; a number pins the trigger in tokens.
LEGAL_HELPER_ANTHROPIC_CLEAR_TOOLS=
