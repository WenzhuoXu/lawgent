# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Provider selection ---
MODEL_PROVIDER=anthropic            # anthropic | openai

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_FAST_MODEL=claude-sonnet-5

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol            # always a named variant; there is no bare "gpt-6.1" alias
OPENAI_FAST_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=medium      # none | low | medium | high | xhigh
OPENAI_ENABLE_FILE_SEARCH=false
OPENAI_FILE_SEARCH_VECTOR_STORE_IDS=

# --- PRC legal data ---
# PKULaw remote HTTP MCP (.mcp.json → pkulaw_*). Token from apim.pkulaw.com;
# sent as the WSO2 `apikey` header. Without it the harness falls back to the
# free flk.npc.gov.cn connector (search/status only, no statute body text).
PKULAW_API_TOKEN=

# --- US legal data (optional; direct-API connectors, no MCP install) ---
GOVINFO_API_KEY=                    # api.data.gov key for GovInfo
COURTLISTENER_API_TOKEN=            # raises CourtListener rate limits

# --- Behavior ---
LEGAL_HELPER_MAX_ITERATIONS=12
LEGAL_HELPER_OUTPUTS_DIR=outputs
LEGAL_HELPER_STATE_DIR=state
LEGAL_HELPER_LOGS_DIR=logs

# --- Context ---
# Conda env that stdio MCP commands (python, npx) are resolved against.
LEGAL_HELPER_MCP_ENV=llm
# Tokens of extracted attachment text a turn may inline before the rest are
# replaced by a navigable outline (headings, clause labels, the read_document
# call that opens them). Unset = 40% of the turn's input ceiling; 0 = inline all.
LEGAL_HELPER_INLINE_ATTACHMENT_TOKENS=
# Anthropic server-side tool-result clearing is on by default, triggered at the
# turn input ceiling. 0/off disables it; a number pins the trigger in tokens.
LEGAL_HELPER_ANTHROPIC_CLEAR_TOOLS=
