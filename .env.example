# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Provider selection ---
MODEL_PROVIDER=anthropic            # anthropic | openai

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_FAST_MODEL=claude-haiku-4-5

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra          # never the bare "gpt-5.6" alias — it routes elsewhere
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=medium      # none | low | medium | high | xhigh
OPENAI_ENABLE_FILE_SEARCH=false
OPENAI_FILE_SEARCH_VECTOR_STORE_IDS=

# --- PRC legal data ---
# PKULaw remote HTTP MCP (.mcp.json → pkulaw_*). Token from apim.pkulaw.com;
# sent as the WSO2 `apikey` header. Without it the harness falls back to the
# free flk.npc.gov.cn connector (search/status only, no statute body text).
PKULAW_API_TOKEN=

# --- US legal data (optional; direct-API connectors, no MCP install) ---
GOVINFO_API_KEY=                    # api.data.gov key for GovInfo
COURTLISTENER_API_TOKEN=            # raises CourtListener rate limits

# --- Behavior ---
LEGAL_HELPER_MAX_ITERATIONS=12
LEGAL_HELPER_OUTPUTS_DIR=outputs
LEGAL_HELPER_STATE_DIR=state
LEGAL_HELPER_LOGS_DIR=logs
